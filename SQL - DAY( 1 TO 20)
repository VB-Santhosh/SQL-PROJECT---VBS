select * from employees where first_name ='Alexander';           -- where is the class used to find a exact value from colum of tables.

select * from employees where department_id >100;          --we use comparison operators like (=,<>,>,<,>=,<=) to find a range values of column from tables.

select phone_number,first_name,job_id,salary from employees where salary>15000;

select * from employees where first_name in ('Steven','William','Gerald','David');  -- "in" is the class used to find two or more exact values of column from tables.

select * from employees where first_name not in ('Steven','William');      -- "not in" is the class used to find two or more except values of column from tables.

select * from employees where salary between 13000 and 17000;          -- "between" is the class used to find the between values of mentioned ones from column.

select * from employees where salary not between 1000 and 13500;     -- "not between" is the class to find except between values of mentioned ones from column.

select * from employees where first_name like 'D_%d';   -- "%" and "_" is the class used to find a values of non-confirmation words with doubted ones, is called Like Operator.
                                                        -- "%" is mean to "Anything has come before or after by this symbol" and
select * from employees where first_name like 'A__s%';  -- "_" is mean to "Only one Position has whatever it comes in this place.
                                                                
select * from employees where job_id like 'FI__%' escape '_';  /*is the class used for various characters in a column to find the 
                                                                  special character contained value by using the Escape operator*/

select * from employees where first_name not like 'P%';  -- 'NOT LIKE' IS USED TO FIND THE VALUES ARE NOT CONTAINING A MENTIONING CONDITION IN SINGLE QUOTES.

select * from employees where commission_pct is null;     --"is" Keyword used for Null Operator. Null indicates the column contains a Null.

select * from employees where commission_pct is not null;     -- Not Null indiactes the column that not contains Null in table.

/* LOGICAL OPERATORS*/
             /*--> Logical operators ( 'AND','OR','NOT'). Lots of conditions can be using by Logical operators 
             with added of Null, Comparison,Arithmetic operations of Restriction in single line query. */
             
 
             
select * from employees where salary = 2500 and first_name like '_%r';    -- "AND" is the logical operator that should be satisfies each and every condition in query.

select * from employees where first_name in ('Alexander','David')or salary = 5000;    -- "OR" is the logical operator that should be satisfies anyone of the condition in query.

select * from employees where (first_name like 'Jo_%' or job_id in('ST CLERK','SA MAN')) and DEPARTMENT_ID between 50 and 90; --Lots of conditions can be using by Logical operators with Datatypes,comparison,Null.

